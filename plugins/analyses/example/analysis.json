{
  "id": "example-copy-volume-sidecar",
  "name": "Example Sidecar: Copy Selected Volume",
  "version": "0.1.0",
  "api_version": "0.1",
  "description": "Runnable sidecar example that copies the selected volume into the job output directory and writes a JSON report.",
  "inputs": ["volume"],
  "params_schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "default": "Example Sidecar Run",
        "title": "Run label"
      }
    },
    "additionalProperties": false
  },
  "outputs": ["volume", "metadata"],
  "runner": {
    "type": "sidecar",
    "command": "bin/copy_volume.py",
    "args": [],
    "env": {},
    "timeout_sec": 120
  }
}
