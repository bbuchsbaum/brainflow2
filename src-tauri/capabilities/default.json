{
    "$schema": "../gen/schemas/desktop-schema.json",
  
    "identifier": "default",
    "description": "Default capability for the main window",
    "windows": ["main"],
  
    "permissions": [
      
      "core:default",
      "core:event:allow-listen",
      "core:event:allow-emit",
      "core:menu:default",
  

      "dialog:default",
      
      "api-bridge:default",
      "api-bridge:allow-load-surface-atlas",
      "api-bridge:allow-remote-mount-connect",
      "api-bridge:allow-remote-mount-respond-host-key",
      "api-bridge:allow-remote-mount-respond-auth",
      "api-bridge:allow-remote-mount-unmount",
      "api-bridge:allow-list-remote-mount-profiles",
      "api-bridge:allow-list-ssh-config-hosts",
      "api-bridge:allow-remote-mount-cancel-connect",
      "api-bridge:allow-remote-list-folders",
      "api-bridge:allow-remote-browse-close",
      "api-bridge:allow-update-remote-mount-profile",
      "api-bridge:allow-set-remote-cache-budget",
      "api-bridge:allow-clear-inactive-remote-caches",
      "api-bridge:allow-remote-prefetch-folder",
      "api-bridge:allow-remote-prefetch-cancel",
      "api-bridge:allow-remove-remote-mount-profile",
  
     
      {
        "identifier": "fs:read-files",
        "allow": [
          { "path": "$DOWNLOAD/*"  },   
          { "path": "$DOWNLOAD/**/*"},
          { "path": "$HOME/*" },
          { "path": "$HOME/**/*" },
          { "path": "$DOCUMENT/*" },
          { "path": "$DOCUMENT/**/*" },
          { "path": "$DESKTOP/*" },
          { "path": "$DESKTOP/**/*" }
        ]
      }
    ]
  }
