:root {
  /* Primitive palette */
  --palette-white: #ffffff;
  --palette-black: #000000;
  --palette-gray-50: #fafafa;
  --palette-gray-100: #f4f4f5;
  --palette-gray-200: #e4e4e7;
  --palette-gray-500: #71717a;
  --palette-gray-700: #3f3f46;
  --palette-gray-900: #18181b;
  --palette-blue-600: #2563eb;
  --palette-red-600: #dc2626;

  /* Semantic colors */
  --color-text-primary: var(--palette-gray-900);
  --color-text-secondary: var(--palette-gray-500);
  --color-surface-1: var(--palette-white);
  --color-surface-2: var(--palette-gray-50);
  --color-surface-raised: var(--palette-white);
  --color-border-subtle: var(--palette-gray-200);
  --color-border-strong: var(--palette-gray-700);
  --color-accent: var(--palette-blue-600);
  --color-accent-contrast: var(--palette-white);
  --color-danger: var(--palette-red-600);
  --color-focus-ring: var(--palette-blue-600);

  /* Spacing */
  --space-0: 0;
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-12: 3rem;

  /* Typography */
  --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.25rem;

  /* Shape and elevation */
  --radius-sm: 0.25rem;
  --radius-md: 0.375rem;
  --radius-lg: 0.5rem;
  --radius-full: 9999px;
  --shadow-sm: 0 1px 2px rgb(0 0 0 / 0.05);
  --shadow-md: 0 8px 24px rgb(0 0 0 / 0.08);
}

[data-theme="dark"] {
  --color-text-primary: var(--palette-gray-50);
  --color-text-secondary: var(--palette-gray-200);
  --color-surface-1: var(--palette-gray-900);
  --color-surface-2: var(--palette-gray-700);
  --color-surface-raised: var(--palette-gray-900);
  --color-border-subtle: var(--palette-gray-700);
  --color-border-strong: var(--palette-gray-200);
}
