{
  "name": "brainflow2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "High-performance neuroimaging visualization platform",
  "scripts": {
    "dev": "cargo tauri dev",
    "build": "pnpm -r build && cargo tauri build",
    "test:unit": "pnpm --filter temp-ui exec vitest run",
    "test:e2e": "pnpm -C e2e test",
    "test": "pnpm test:unit && cargo test",
    "lint": "pnpm -r lint || true && cargo clippy",
    "format": "pnpm -r format || true && cargo fmt",
    "check": "pnpm -r check",
    "bench": "cargo bench",
    "ts-bindings": "cargo xtask ts-bindings",
    "check:permissions": "node tools/check_api_bridge_permissions.mjs",
    "check:permissions:strict": "CI_STRICT_PERMISSIONS=1 node tools/check_api_bridge_permissions.mjs",
    "clean": "pnpm -r clean && cargo clean",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "browserslist@<4.28.7": "^4.28.7",
      "flatted@<3.4.2": "^3.4.2",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.18": "^8.5.18",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-104848",
        "CVE-2026-104849"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bbuchsbaum/brainflow2"
  },
  "license": "MIT",
  "author": "Brainflow Team"
}
